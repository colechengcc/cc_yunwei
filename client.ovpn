##############################################
# OpenVPN 客户端配置文件
# 支持证书 + 用户名密码双重认证
##############################################

# 指定这是客户端
client

# 使用tun设备
dev tun

# 协议类型（必须与服务器匹配）
proto udp

# 服务器地址和端口
# 请替换为您的实际服务器地址
remote 111.175.39.190 49512

# 如果有多个remote配置，随机选择
# remote-random

# 保持尝试连接
resolv-retry infinite

# 不绑定本地端口
nobind

# 持久化选项
persist-key
persist-tun

# 启用用户名密码认证
# OpenVPN会提示输入用户名和密码
auth-user-pass

# 如果想保存用户名密码到文件（不推荐，安全性较低）
# 创建一个文件，第一行是用户名，第二行是密码
# auth-user-pass userpass.txt

# 验证服务器证书
remote-cert-tls server

# 加密算法（必须与服务器匹配）
cipher AES-256-CBC

# 日志级别
verb 3

# TLS密钥方向
key-direction 1

# 静默重复的日志消息
;mute 20

##############################################
# 嵌入式证书和密钥
# 以下内容需要替换为实际的证书和密钥
##############################################

# CA证书
<ca>
-----BEGIN CERTIFICATE-----
# 将 /etc/openvpn/easy-rsa/pki/ca.crt 的内容粘贴到这里
# 从 -----BEGIN CERTIFICATE----- 到 -----END CERTIFICATE-----
-----END CERTIFICATE-----
</ca>

# 客户端证书
<cert>
-----BEGIN CERTIFICATE-----
# 将客户端证书文件的内容粘贴到这里
# 例如：/etc/openvpn/easy-rsa/pki/issued/client1.crt
# 从 -----BEGIN CERTIFICATE----- 到 -----END CERTIFICATE-----
-----END CERTIFICATE-----
</cert>

# 客户端私钥
<key>
-----BEGIN PRIVATE KEY-----
# 将客户端私钥文件的内容粘贴到这里
# 例如：/etc/openvpn/easy-rsa/pki/private/client1.key
# 从 -----BEGIN PRIVATE KEY----- 到 -----END PRIVATE KEY-----
# 或 -----BEGIN RSA PRIVATE KEY----- 到 -----END RSA PRIVATE KEY-----
-----END PRIVATE KEY-----
</key>

# TLS认证密钥
<tls-auth>
-----BEGIN OpenVPN Static key V1-----
# 将 /etc/openvpn/easy-rsa/ta.key 的内容粘贴到这里
-----END OpenVPN Static key V1-----
</tls-auth>

##############################################
# 使用说明：
# 1. 将上述证书和密钥部分替换为实际内容
# 2. 连接时会提示输入用户名和密码
# 3. 只有同时满足以下条件才能连接成功：
#    - 拥有有效的客户端证书和私钥
#    - 提供正确的用户名和密码（在服务器的psw-file中）
##############################################
